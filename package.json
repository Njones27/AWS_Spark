{
  "name": "spark-cloud-builders",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/import-icons.mjs",
    "site-icons": "node scripts/make-site-icons.mjs",
    "test:all": "vitest run && npm test -w backend && npm test -w infra",
    "typecheck:all": "tsc -b --noEmit && npm run typecheck -w backend && npm run typecheck -w infra"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@xyflow/react": "^12.12.1",
    "html-to-image": "1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~7.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "backend",
    "infra"
  ],
  "engines": {
    "node": ">=24"
  }
}
